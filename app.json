{
  "expo": {
    "name": "Expiry Vault",
    "slug": "expiry-vault",
    "owner": "mihirpatel9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expiryvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mihirpatel.expiryvault",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mihirpatel.expiryvault",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Expiry Vault uses Face ID to unlock your encrypted documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Expiry Vault uses the camera so you can attach a photo of a document to its entry. The photo stays on this device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Expiry Vault uses a photo you choose so you can attach a picture of a document to its entry. Nothing is uploaded."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Expiry Vault uses Face ID to unlock your encrypted documents."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ec730cb-a954-430b-ad4d-5b7c2bcf456e"
      }
    }
  }
}
