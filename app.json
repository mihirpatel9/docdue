{
  "expo": {
    "name": "DocDue",
    "slug": "docdue",
    "owner": "mihirpatel9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docdue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mihirpatel.docdue",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mihirpatel.docdue",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "DocDue uses Face ID to unlock your encrypted documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DocDue uses a photo you choose so you can attach a picture of a document to its entry. Nothing is uploaded.",
          "cameraPermission": "DocDue opens the camera so you can photograph a document. The photo goes straight into the encrypted vault on this device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DocDue uses Face ID to unlock your encrypted documents."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ec730cb-a954-430b-ad4d-5b7c2bcf456e"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7ec730cb-a954-430b-ad4d-5b7c2bcf456e"
    }
  }
}
